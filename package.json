{
  "name": "flowplan-desktop",
  "productName": "Flowplan",
  "version": "1.0.8",
  "description": "Flowplan as a desktop app for macOS, Windows and Linux",
  "main": "main.js",
  "private": true,
  "author": "Flowplan",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check updates.js && node --check sign-in.js && node --check fallback.js && node --check guards.js && node --check profiles.js && node --check notifications.js && node --check notifier.js && node --check strings.js && node --check handoff.js && node --check settings.js && node --check context-menu.js && node --check instance-api.js && node --check capture.js && node --check tray.js && node --check deep-links.js && node --check page-windows.js && node --check files.js && node --check autostart.js && node --check print.js && node --check pages/setup.js && node --check pages/offline.js && node --check pages/sign-in-page.js && node --check pages/profiles-page.js && node --check pages/i18n.js && node --check pages/settings-page.js && node --check pages/capture-page.js && node --check pages/update-page.js && node --check test/security.mjs && node --check test/update.mjs && node --check test/offline.mjs && node --check test/smoke.mjs && node --check test/profiles.mjs && node --check test/notifications.mjs && node --check test/handoff.mjs && node --check test/features.mjs && node --check test/app.mjs && node --check test/stand-in.mjs",
    "test": "node test/security.mjs && node test/features.mjs && node test/offline.mjs && node test/profiles.mjs && node test/notifications.mjs && node test/handoff.mjs && node test/app.mjs",
    "test:security": "node test/security.mjs",
    "test:features": "node test/features.mjs",
    "test:offline": "node test/offline.mjs",
    "test:profiles": "node test/profiles.mjs",
    "test:notifications": "node test/notifications.mjs",
    "test:handoff": "node test/handoff.mjs",
    "test:app": "node test/app.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:update": "node test/update.mjs",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "app.flowplan.desktop",
    "productName": "Flowplan",
    "copyright": "Flowplan",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updates.js",
      "sign-in.js",
      "fallback.js",
      "guards.js",
      "profiles.js",
      "notifications.js",
      "notifier.js",
      "strings.js",
      "handoff.js",
      "settings.js",
      "context-menu.js",
      "instance-api.js",
      "capture.js",
      "tray.js",
      "deep-links.js",
      "page-windows.js",
      "files.js",
      "autostart.js",
      "print.js",
      "pages/**",
      "build/icon.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/update.json",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Flowplan",
        "schemes": [
          "flowplan"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "artifactName": "Flowplan-${version}-mac.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Flowplan uses the microphone for voice notes.",
        "NSUserActivityTypes": [
          "app.flowplan.page"
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Flowplan Import",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf",
              "public.png",
              "public.jpeg",
              "com.compuserve.gif",
              "org.webmproject.webp",
              "public.avif",
              "public.heic",
              "net.daringfireball.markdown",
              "public.plain-text"
            ]
          }
        ]
      }
    },
    "dmg": {
      "title": "Flowplan"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Flowplan-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Flowplan",
      "artifactName": "Flowplan-${version}-windows-setup.${ext}"
    },
    "linux": {
      "category": "Office",
      "executableName": "flowplan",
      "maintainer": "Yannic Schuller <76843349+yannicschuller@users.noreply.github.com>",
      "synopsis": "Documents, databases, whiteboards and a journal",
      "description": "Flowplan as a desktop app: a window around a Flowplan instance with native menus, offline use and updates. All data stays on the server.",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Keywords": "flowplan;notes;documents;databases;whiteboard;journal;wiki;",
          "StartupWMClass": "flowplan"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Flowplan-${version}-linux-${arch}.${ext}",
      "mimeTypes": [
        "application/pdf",
        "image/png",
        "image/jpeg",
        "image/gif",
        "image/webp",
        "image/avif",
        "text/markdown",
        "text/plain"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yannicschuller",
        "repo": "flowplan-desktop",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://flowplan.org/download",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yannicschuller/flowplan-desktop.git"
  },
  "desktopName": "flowplan.desktop"
}
